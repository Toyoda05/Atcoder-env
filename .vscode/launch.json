{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "CP: Python (active file + input.txt)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "program": "${workspaceFolder}/tools/debug_python.py",
      "args": ["${file}"],
      "cwd": "${fileDirname}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "CP: C++ (active file + input.txt)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/.build/debug-main",
      "args": ["<", "${fileDirname}/input.txt"],
      "cwd": "${fileDirname}",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "CP: Build debug active C++",
      "setupCommands": [{"text": "-enable-pretty-printing", "ignoreFailures": true}]
    }
  ]
}
